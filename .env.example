# Copy to .env with: python3 scripts/make_env.py
# That script replaces every change-me value with a random secret.

# Postgres superuser (only the postgres container sees this)
POSTGRES_PASSWORD=change-me

# Airflow metadata database
AIRFLOW_DB_PASSWORD=change-me

# Warehouse roles, see docs/adr/0001-warehouse-layout-and-roles.md
LOADER_PASSWORD=change-me
TRANSFORMER_PASSWORD=change-me
REPORTER_PASSWORD=change-me

# Airflow UI login
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# Airflow internals
AIRFLOW_FERNET_KEY=change-me-fernet
AIRFLOW_JWT_SECRET=change-me
# On Linux set this to the output of `id -u`. Leave as is on macOS.
AIRFLOW_UID=50000

# Host ports
WAREHOUSE_PORT=5432
AIRFLOW_PORT=8080
